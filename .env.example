# Server Configuration
HOST=0.0.0.0
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider Configuration (options: mock, openai, gemini)
LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gpt-4o-mini

# Brand Guardrail Configuration
STRICT_BUZZWORD_FILTER=true
MIN_COMPLIANCE_SCORE_PERCENT=85.0
DATABASE_PATH=data/omni_brand.sqlite3
